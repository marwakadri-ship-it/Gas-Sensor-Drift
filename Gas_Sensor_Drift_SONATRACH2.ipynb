   "source": [
    "\n",
    "\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import accuracy_score, classification_report\n",
    "import numpy as np\n",
    "\n",
    "GAS_NAMES = {\n",
    "    1: 'Ethanol', 2: 'Ethylene', 3: 'Ammonia',\n",
    "    4: 'Acetaldehyde', 5: 'Acetone', 6: 'Toluene'\n",
    "}\n",
    "\n",
    "def load_batches(batch_numbers, base_path):\n",
    "    \"\"\"Parse LibSVM format manually — compatible with local files.\"\"\"\n",
    "    X_list, y_list, batch_list = [], [], []\n",
    "    for i in batch_numbers:\n",
    "        file_path = os.path.join(base_path, f\"batch{i}.dat\")\n",
    "        with open(file_path, 'r') as f:\n",
    "            for line in f:\n",
    "                parts = line.strip().split()\n",
    "                if not parts:\n",
    "                    continue\n",
    "                label = float(parts[0])\n",
    "                features = [0.0] * 128\n",
    "                for item in parts[1:]:\n",
    "                    idx_val = item.split(':')\n",
    "                    if len(idx_val) == 2:\n",
    "                        idx = int(idx_val[0]) - 1\n",
    "                        val = float(idx_val[1])\n",
    "                        if idx < 128:\n",
    "                            features[idx] = val\n",
    "                X_list.append(features)\n",
    "                y_list.append(label)\n",
    "                batch_list.append(i)\n",
    "    return (\n",
    "        np.array(X_list),\n",
    "        np.array(y_list),\n",
    "        np.array(batch_list)\n",
    "    )\n",
    "\n",
    "print(\"load_batches defined successfully ✓\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "---\n",
    "## Part 2 — Gas Type Classification (Despite Sensor Drift)\n",
    "**Goal:** Build a model that correctly identifies the gas type (Ethanol, Ammonia, etc.) even when sensors have aged significantly.\n",
    "**Industrial relevance:** Critical for safety alert systems in oil & gas facilities."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Accuracy on aged sensors (Batches 8-10): 61.16%\n",
      "\n",
      "Classification Report:\n",
      "              precision    recall  f1-score   support\n",
      "\n",
      "     Ethanol       0.69      0.47      0.56       691\n",
      "    Ethylene       0.57      0.62      0.59       685\n",
      "     Ammonia       0.68      0.62      0.65       740\n",
      "Acetaldehyde       0.45      0.70      0.55       708\n",
      "     Acetone       0.75      0.83      0.79       821\n",
      "     Toluene       0.60      0.39      0.47       719\n",
      "\n",
      "    accuracy                           0.61      4364\n",
      "   macro avg       0.62      0.61      0.60      4364\n",
      "weighted avg       0.63      0.61      0.61      4364\n",
      "\n"
     ]
    }
   ],
   "source": [
    "\n",
    "X_train, y_train, _ = load_batches([1,2,3,4,5,6,7], dataset_path)  \n",
    "X_test,  y_test,  _ = load_batches([8, 9, 10], dataset_path)       \n",
    "\n",
    "scaler = StandardScaler()\n",
    "X_train_sc = scaler.fit_transform(X_train)\n",
    "X_test_sc  = scaler.transform(X_test)\n",
    "\n",
    "clf = RandomForestClassifier(n_estimators=200, max_depth=15,\n",
    "                             random_state=42, n_jobs=-1)\n",
    "clf.fit(X_train_sc, y_train)\n",
    "\n",
    "y_pred = clf.predict(X_test_sc)\n",
    "acc = accuracy_score(y_test, y_pred)\n",
    "\n",
    "print(f\"Accuracy on aged sensors (Batches 8-10): {acc * 100:.2f}%\\n\")\n",
    "print(\"Classification Report:\")\n",
    "print(classification_report(\n",
    "    y_test, y_pred,\n",
    "    target_names=[GAS_NAMES[int(c)] for c in sorted(np.unique(y_test))]\n",
    "))"
   ]
