    "    Xb_sc  = scaler.transform(Xb)\n",
    "    Xb_pca = pca.transform(Xb_sc)\n",
    "\n",
    "    acc_baseline.append(round(accuracy_score(yb, clf.predict(Xb_sc))  * 100, 2))\n",
    "    acc_pca_list.append(round(accuracy_score(yb, clf_pca.predict(Xb_pca)) * 100, 2))\n",
    "\n",
    "batches = list(range(1, 11))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(11, 5))\n",
    "\n",
    "ax.plot(batches, acc_baseline, marker='o', linewidth=2.5, color='#A32D2D',\n",
    "        markersize=8, label='Baseline — RF (Batches 1–7)')\n",
    "ax.plot(batches, acc_pca_list, marker='s', linewidth=2.5, color='#185FA5',\n",
    "        markersize=8, label='Improved — RF + PCA (60 components)')\n",
