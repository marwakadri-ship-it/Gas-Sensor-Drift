    "# ── Accuracy degradation curve across all 10 batches ──\n",
    "batch_accuracies = []\n",
    "for i in range(1, 11):\n",
    "    Xb, yb, _ = load_batches([i], dataset_path)\n",
    "    Xb_sc = scaler.transform(Xb)\n",
    "    batch_accuracies.append(round(accuracy_score(yb, clf.predict(Xb_sc)) * 100, 2))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "ax.plot(range(1, 11), batch_accuracies, marker='o', linewidth=2.5,\n",
    "        color='#185FA5', markersize=9, zorder=3, label='Classification accuracy')\n",
    "ax.fill_between(range(1, 11), batch_accuracies, alpha=0.1, color='#185FA5')\n",
    "ax.axhline(y=batch_accuracies[0], color='#A32D2D', linestyle='--',\n",
    "           linewidth=1.5, label=f'Baseline — Batch 1 ({batch_accuracies[0]:.1f}%)')\n",
    "\n",
    "for i, val in enumerate(batch_accuracies):\n",
