    "# ── Part 3 (Alternative) — Drift Severity Regression ──\n",
    "\n",
    "\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.preprocessing import PolynomialFeatures\n",
    "from sklearn.metrics import mean_absolute_error, r2_score\n",
    "\n",
    "\n",
    "batches_x  = np.array(range(1, 11)).reshape(-1, 1)\n",
    "acc_y      = np.array(acc_pca_list)   # دقة RF+PCA عبر الـ 10 batches\n",
    "\n",
    "# ── Polynomial Regression degree 2 ──\n",
    "poly = PolynomialFeatures(degree=2)\n",
    "X_poly = poly.fit_transform(batches_x)\n",
    "\n",
    "reg = LinearRegression()\n",
    "reg.fit(X_poly, acc_y)\n",
    "\n",
    "\n",
    "future_batches = np.arange(1, 16).reshape(-1, 1)\n",
    "future_poly    = poly.transform(future_batches)\n",
    "future_acc     = reg.predict(future_poly)\n",
    "\n",
    "\n",
    "threshold = 50.0\n",
    "below_threshold = np.where(future_acc < threshold)[0]\n",
    "if len(below_threshold) > 0:\n",
    "    critical_batch = below_threshold[0] + 1\n",
    "    critical_month = round((critical_batch - 1) * 3.6)\n",
    "    print(f\"⚠️  Predicted critical point: Batch {critical_batch} (~Month {critical_month})\")\n",
    "    print(f\"   At this point accuracy drops below {threshold}% — sensor replacement needed.\")\n",
    "else:\n",
    "    print(\"Accuracy stays above 50% for the predicted period.\")\n",
    "\n",
    "# ── Plot ──\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "\n",
    "ax.scatter(range(1, 11), acc_y, color='#185FA5', s=80, zorder=5, label='Measured accuracy')\n",
    "ax.plot(range(1, 16), future_acc, color='#A32D2D', linewidth=2.5,\n",
    "        linestyle='--', label='Polynomial regression forecast')\n",
    "ax.axhline(y=threshold, color='#BA7517', linestyle=':', linewidth=2,\n",
    "           label=f'Safety threshold ({threshold}%)')\n",
    "\n",
    "if len(below_threshold) > 0:\n",
    "    ax.axvline(x=critical_batch, color='#A32D2D', linestyle=':', linewidth=1.5, alpha=0.7)\n",
    "    ax.annotate(f'Critical point\\nBatch {critical_batch}\\n(~Month {critical_month})',\n",
    "                xy=(critical_batch, threshold),\n",
    "                xytext=(critical_batch + 0.3, threshold + 8),\n",
    "                fontsize=9, color='#A32D2D',\n",
    "                arrowprops=dict(arrowstyle='->', color='#A32D2D'))\n",
    "\n",
    "ax.fill_between(range(1, 16), future_acc, threshold,\n",
    "                where=[v < threshold for v in future_acc],\n",
    "                alpha=0.15, color='#A32D2D', label='Danger zone')\n",
    "\n",
    "ax.set_title('Predictive Maintenance Forecast\\n'\n",
    "             'When will sensor accuracy drop below the safety threshold?', fontsize=12)\n",
    "ax.set_xlabel('Batch (≈ every 3–4 months)', fontsize=11)\n",
    "ax.set_ylabel('Predicted Accuracy (%)', fontsize=11)\n",
    "ax.set_xticks(range(1, 16))\n",
    "ax.set_xticklabels([f'B{i}' for i in range(1, 16)], fontsize=8)\n",
    "ax.legend(fontsize=10)\n",
    "ax.grid(axis='y', linestyle='--', alpha=0.4)\n",
    "ax.set_ylim(0, 115)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('predictive_maintenance_forecast.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "r2  = r2_score(acc_y, reg.predict(X_poly))\n",
    "mae = mean_absolute_error(acc_y, reg.predict(X_poly))\n",
    "print(f\"\\nPolynomial Regression fit: R² = {r2:.4f} | MAE = {mae:.2f}%\")"
   ]
