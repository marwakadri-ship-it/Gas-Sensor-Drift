   "source": [
    "# ── 1C: Drift magnitude — quantify how much each sensor drifts ──\n",
    "# Drift = absolute % change in mean signal from Batch 1 to Batch 10\n",
    "drift_df = pd.DataFrame({\n",
    "    'Sensor': [f'S{i+1}' for i in range(16)],\n",
    "    'Mean_Batch1':  batch_means.iloc[0].values,\n",
    "    'Mean_Batch10': batch_means.iloc[-1].values\n",
    "})\n",
    "drift_df['Drift_pct'] = (\n",
    "    (drift_df['Mean_Batch10'] - drift_df['Mean_Batch1']).abs() /\n",
    "    (drift_df['Mean_Batch1'].abs() + 1e-9) * 100\n",
    ").round(1)\n",
    "\n",
    "drift_df_sorted = drift_df.sort_values('Drift_pct', ascending=True)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 5))\n",
    "bars = ax.barh(drift_df_sorted['Sensor'], drift_df_sorted['Drift_pct'],\n",
    "               color='#185FA5', alpha=0.85)\n",
    "ax.set_xlabel('Drift magnitude (% change from Batch 1 to Batch 10)', fontsize=11)\n",
    "ax.set_title('Sensor Drift Ranking — Which sensors degrade the most?', fontsize=13)\n",
    "for bar, val in zip(bars, drift_df_sorted['Drift_pct']):\n",
    "    ax.text(bar.get_width() + 0.5, bar.get_y() + bar.get_height()/2,\n",
    "            f'{val:.1f}%', va='center', fontsize=9, color='#0C447C')\n",
    "ax.grid(axis='x', linestyle='--', alpha=0.4)\n",
    "plt.tight_layout()\n",
    "plt.savefig('sensor_drift_ranking.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"Figure saved: sensor_drift_ranking.png\")\n",
    "print(\"\\nTop 3 most drifted sensors:\")\n",
    "print(drift_df.nlargest(3, 'Drift_pct')[['Sensor','Drift_pct']])"
   ]
