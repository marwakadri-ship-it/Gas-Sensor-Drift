   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# 1. Use the dataset path we verified earlier\n",
    "dataset_path = r\"C:\\Users\\LA CASA TECHNOLOGY\\Downloads\\Gas_Sensor_Drift\\Dataset\"\n",
    "\n",
    "all_batches = []\n",
    "\n",
    "# 2. Loop through all 10 batches, parse the UCI LibSVM format, and load them\n",
    "print(\"Loading batches into DataFrame... Please wait a moment.\")\n",
    "for batch_id in range(1, 11):\n",
    "    file_path = os.path.join(dataset_path, f\"batch{batch_id}.dat\")\n",
    "    \n",
    "    if os.path.exists(file_path):\n",
    "        with open(file_path, 'r') as f:\n",
    "            for line in f:\n",
    "                parts = line.strip().split()\n",
    "                if not parts:\n",
    "                    continue\n",
    "                \n",
    "                # Extract the target/label (gas type)\n",
    "                label = float(parts[0])\n",
    "                \n",
    "                # Create a blank vector for all 128 features (16 sensors * 8 features each)\n",
    "                features = [0.0] * 128\n",
    "                \n",
    "                # Parse indices like '1:123.45'\n",
    "                for item in parts[1:]:\n",
    "                    idx_val = item.split(':')\n",
    "                    if len(idx_val) == 2:\n",
    "                        idx = int(idx_val[0]) - 1 # 1-based to 0-based index\n",
    "                        val = float(idx_val[1])\n",
    "                        if idx < 128:\n",
    "                            features[idx] = val\n",
    "                            \n",
    "                # Save data point with its batch ID\n",
    "                row = [batch_id, label] + features\n",
    "                all_batches.append(row)\n",
    "\n",
    "# 3. Create clean column names matching your visualization script\n",
    "# Feature 1 for Sensor 1 will be 'S1_f1', Feature 2 will be 'S1_f2', etc.\n",
    "columns = ['batch', 'label']\n",
    "for s in range(1, 17):\n",
    "    for f in range(1, 9):\n",
    "        columns.append(f'S{s}_f1' if f == 1 else f'S{s}_f{f}')\n",
    "\n",
    "df = pd.DataFrame(all_batches, columns=columns)\n",
    "print(f\"✅ Successfully created 'df'! Shape: {df.shape}\")"
   ]
  },
