    "from sklearn.decomposition import PCA\n",
    "\n",
    "# ── Stratégie 2 : PCA Domain Adaptation ──\n",
    "\n",
    "pca = PCA(n_components=60)  \n",
    "\n",
    "X_train_pca = pca.fit_transform(X_train_sc)\n",
    "X_test_pca  = pca.transform(X_test_sc)\n",
    "\n",
    "print(f\"Variance explained by 60 components: {pca.explained_variance_ratio_.sum()*100:.1f}%\\n\")\n",
    "\n",
    "clf_pca = RandomForestClassifier(n_estimators=300, max_depth=20,\n",
    "                                  random_state=42, n_jobs=-1)\n",
    "clf_pca.fit(X_train_pca, y_train)\n",
    "\n",
    "y_pred_pca = clf_pca.predict(X_test_pca)\n",
    "acc_pca = accuracy_score(y_test, y_pred_pca)\n",
    "\n",
    "print(f\"Accuracy WITHOUT PCA : {acc * 100:.2f}%\")\n",
    "print(f\"Accuracy WITH PCA    : {acc_pca * 100:.2f}%\")\n",
    "print(f\"Improvement          : +{(acc_pca - acc)*100:.2f}%\\n\")\n",
    "\n",
    "print(\"Classification Report (with PCA):\")\n",
    "print(classification_report(\n",
    "    y_test, y_pred_pca,\n",
    "    target_names=[GAS_NAMES[int(c)] for c in sorted(np.unique(y_test))]\n",
    "))"
