    "# ── 1A: Signal Drift — Average sensor response per batch ──\n",
    "# We use the first feature of each of the 16 sensors as a proxy for signal strength\n",
    "sensor_cols_f1 = [f'S{s+1}_f1' for s in range(16)]\n",
    "\n",
    "batch_means = df.groupby('batch')[sensor_cols_f1].mean()\n",
    "\n",
    "fig, axes = plt.subplots(4, 4, figsize=(16, 10), sharey=False)\n",
    "fig.suptitle('Sensor Signal Drift Over 36 Months (Feature 1 — Mean Response)', \n",
    "             fontsize=14, y=1.01)\n",
    "\n",
    "for idx, col in enumerate(sensor_cols_f1):\n",
    "    ax = axes[idx // 4][idx % 4]\n",
    "    vals = batch_means[col].values\n",
    "    ax.plot(range(1, 11), vals, marker='o', linewidth=2, color='#185FA5', markersize=5)\n",
    "    ax.fill_between(range(1, 11), vals, alpha=0.15, color='#185FA5')\n",
    "    ax.set_title(f'Sensor {idx+1}', fontsize=10)\n",
    "    ax.set_xlabel('Batch', fontsize=8)\n",
    "    ax.set_xticks(range(1, 11))\n",
    "    ax.tick_params(labelsize=7)\n",
    "    ax.grid(axis='y', linestyle='--', alpha=0.5)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('sensor_signal_drift_per_sensor.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"Figure saved: sensor_signal_drift_per_sensor.png\")"
   ]
